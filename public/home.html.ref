<style data-related="n2-ss-972">div#n2-ss-972 .n2-ss-slider-1 { display: grid; box-sizing: border-box; position: relative; background-repeat: repeat; background-position: 50% 50%; background-size: cover; background-attachment: scroll; border: 0px solid rgb(62, 62, 62); border-radius: 0px; overflow: hidden; }
div#n2-ss-972:not(.n2-ss-loaded) .n2-ss-slider-1 { background-image: none !important; }
div#n2-ss-972 .n2-ss-slider-2 { display: grid; place-items: center; position: relative; overflow: hidden; z-index: 10; }
div#n2-ss-972 .n2-ss-slider-3 { position: relative; width: 100%; height: 100%; z-index: 20; display: grid; grid-template-areas: "slide"; }
